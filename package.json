{
  "name": "dsh-models",
  "version": "0.1.4",
  "description": "Model menu for the dsh web GUI: search-first model picker + reasoning-effort selector, per-session subagent model routing, dim-powered price badges and new-model discovery, and a settings-page management card",
  "type": "module",
  "scripts": {
    "test": "node scripts/host-route.mjs && node scripts/interaction.mjs"
  },
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "install.sh",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "deepseek",
    "harness",
    "agent-harness",
    "plugin",
    "model",
    "picker",
    "subagent",
    "web",
    "ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taxueseek/dsh-models.git"
  },
  "homepage": "https://github.com/taxueseek/dsh-models",
  "bugs": {
    "url": "https://github.com/taxueseek/dsh-models/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": "^0.2.0-rc.1 || ^0.2.0-rc.2 || ^0.2.1-alpha.3",
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-alpha.3": "compatible"
      },
      "dshOperations": {
        "0.2.0-rc.2": {
          "install": "unknown",
          "start": "unknown",
          "uninstall": "unknown",
          "rollback": "unknown"
        }
      }
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*"
  }
}
